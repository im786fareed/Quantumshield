# Copy this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties to git — it contains sensitive credentials.
#
# HOW TO CREATE A KEYSTORE:
# Run this command in your terminal (requires Java / Android Studio installed):
#
#   keytool -genkey -v -keystore AdamasVault-release.jks \
#     -alias AdamasVault \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=AdamasVault, OU=Security, O=AdamasVault, L=India, S=India, C=IN"
#
# Then place AdamasVault-release.jks inside android/ folder (it is gitignored via *.jks)

storeFile=AdamasVault-release.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=AdamasVault
keyPassword=YOUR_KEY_PASSWORD_HERE
